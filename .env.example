# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_ENV=development
API_LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://admin:password@postgres:5432/veritas_grid
DATABASE_POOL_SIZE=10

# Redis
REDIS_URL=redis://redis:6379
REDIS_QUEUE_NAME=veritas-grid-jobs

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRY=24h
API_KEY_PREFIX=vg_

# Features
FRAUD_DETECTION_ENABLED=true
TRUST_SCORING_ENABLED=true
ROUTING_ENABLED=true

# External Services
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=
RAILWAY_TOKEN=
VERCEL_TOKEN=

# Monitoring
SENTRY_DSN=
DATADOG_API_KEY=

# Worker
WORKER_CONCURRENCY=5
WORKER_QUEUE_NAME=veritas-grid-jobs
WORKER_JOB_TIMEOUT=30000

# Web
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=Veritas Grid
